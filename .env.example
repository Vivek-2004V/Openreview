# ==============================================================================
# OpenReview AI - Environment Configuration Example
#
# Copy this file to '.env' and provide deployment-specific values.
# NEVER commit your actual '.env' file or private keys to version control.
# (Both '.env' and '*.pem' are protected in .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub App Integration & Authentication
# ------------------------------------------------------------------------------
# The GitHub App numeric ID (from your GitHub App settings page).
GITHUB_APP_ID=123456

# The HMAC-SHA256 secret configured in your GitHub App webhook settings.
# Used to verify incoming webhook payloads (X-Hub-Signature-256) before processing.
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret_string

# File path to the RSA private key (.pem) downloaded from your GitHub App.
# In Docker deployments, mount this read-only into '/secrets/github-app-private-key.pem'.
# File permissions should be restricted to 0600 (owner read-only).
GITHUB_PRIVATE_KEY_PATH=/secrets/github-app-private-key.pem

# ------------------------------------------------------------------------------
# 2. Webhook Server & Job Queue Settings
# ------------------------------------------------------------------------------
# Host interface and TCP port for the webhook ingestion HTTP server.
OPENREVIEW_SERVER_HOST=0.0.0.0
OPENREVIEW_SERVER_PORT=8000

# Path to persistent SQLite review job queue database.
# In Docker deployments, this should reside in a mounted persistent volume (/data).
OPENREVIEW_JOBS_DB=/data/openreview_jobs.db

# Optional JWT API Secret for authenticating client requests to protected endpoints (e.g. /jobs/<id>).
# When set, bearer tokens signed with this key (HS256) are required.
OPENREVIEW_API_SECRET=replace_with_a_long_random_jwt_api_secret_key

# Request rate limiting: maximum allowed requests per minute per client IP.
OPENREVIEW_RATE_LIMIT=60

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# All log messages and arguments automatically filter credentials and tokens.
OPENREVIEW_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Local-First AI Engine Configuration (Ollama)
# ------------------------------------------------------------------------------
# Toggle local AI review analysis. When false, only static scanners (Ruff, ESLint, REA) run.
OPENREVIEW_AI_ENABLED=true

# AI provider adapter (default: ollama).
OPENREVIEW_AI_PROVIDER=ollama

# The local model tag installed in your Ollama instance.
# Recommended coding models: qwen2.5-coder:7b, deepseek-coder:6.7b
OPENREVIEW_AI_MODEL=qwen2.5-coder:7b

# Ollama HTTP API endpoint:
# - On host machine / bare-metal: http://127.0.0.1:11434
# - Inside Docker Desktop (Mac/Win) connecting to host Ollama: http://host.docker.internal:11434
# - Inside Docker Compose network with an 'ollama' service: http://ollama:11434
# Note: '127.0.0.1' inside a container refers to the container itself, NOT the host.
OPENREVIEW_AI_ENDPOINT=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 4. Process Isolation & Docker Sandbox Security Controls
# ------------------------------------------------------------------------------
# When set to 'true', enforces strict Docker container isolation for all untrusted
# PR review execution and patch testing. If the Docker daemon is unreachable or
# the container image is missing, the engine FAILS CLOSED and refuses to execute
# code on the host system. Set to 'false' only for trusted local developer testing.
OPENREVIEW_REQUIRE_CONTAINER=true

# Container execution timeout in seconds. The container process is forcefully
# terminated (SIGKILL) if analysis exceeds this threshold.
OPENREVIEW_SANDBOX_TIMEOUT_SECONDS=120

# Memory limit for the container sandbox (e.g., 512m, 1g). Enforced via cgroups.
OPENREVIEW_SANDBOX_MEMORY_LIMIT=512m

# Maximum CPU cores allocated to the container sandbox.
OPENREVIEW_SANDBOX_CPUS=1.0

# Maximum process and thread count inside the container to prevent fork bombs.
OPENREVIEW_SANDBOX_PIDS_LIMIT=100

# Docker image tags used for containerized reviews and patch validation.
# Build with: docker build -t openreview-patch-validator:latest -f Dockerfile.validator .
OPENREVIEW_CONTAINER_IMAGE=openreview-scanner:latest
OPENREVIEW_VALIDATOR_IMAGE=openreview-patch-validator:latest

# ------------------------------------------------------------------------------
# 5. Privacy & Data Protection Safeguards
# ------------------------------------------------------------------------------
# Automatically redact detected API tokens, private keys, and passwords from review diffs.
OPENREVIEW_PRIVACY_REDACT_SECRETS=true

# Enforce local loopback interfaces for AI calls; rejects remote non-loopback URLs.
OPENREVIEW_PRIVACY_ENFORCE_LOCAL_AI=false
